
{
  "$canonical": "Canonical event model (scope_decisions.md D6): every event is { type, sessionId, taskId?, timestamp, payload }. Redis Pub/Sub messages and SSE data: frames are JSON encodings of this same model. Session states (D5): idle | running | streaming | waiting | completed | error. Approval events (D11): session-level HITL confirmed in MVP. task.* events remain internal (see Redis_Event_Schema.md).",
  "session.created": {
    "type": "session.created",
    "sessionId": "string",
    "timestamp": "number",
    "payload": {
      "state": "idle"
    }
  },
  "session.started": {
    "type": "session.started",
    "sessionId": "string",
    "timestamp": "number",
    "payload": {
      "state": "running",
      "input": {},
      "config": {}
    }
  },
  "session.stateChanged": {
    "type": "session.stateChanged",
    "sessionId": "string",
    "timestamp": "number",
    "payload": {
      "from": "idle | running | streaming | waiting | completed | error",
      "to": "idle | running | streaming | waiting | completed | error"
    }
  },
  "output.partial": {
    "type": "output.partial",
    "sessionId": "string",
    "timestamp": "number",
    "payload": {
      "chunk": {}
    }
  },
  "output.final": {
    "type": "output.final",
    "sessionId": "string",
    "timestamp": "number",
    "payload": {
      "output": {}
    }
  },
  "log.append": {
    "type": "log.append",
    "sessionId": "string",
    "timestamp": "number",
    "payload": {
      "severity": "info | warn | error",
      "message": "string"
    }
  },
  "session.error": {
    "type": "session.error",
    "sessionId": "string",
    "timestamp": "number",
    "payload": {
      "error": {
        "message": "string",
        "stack": "string",
        "code": "string"
      }
    }
  },
  "session.completed": {
    "type": "session.completed",
    "sessionId": "string",
    "timestamp": "number",
    "payload": {
      "state": "completed",
      "durationMs": "number",
      "tokensUsed": "number"
    }
  },
  "approval.requested": {
    "type": "approval.requested",
    "sessionId": "string",
    "timestamp": "number",
    "payload": {
      "prompt": "string",
      "options": ["string"]
    }
  },
  "approval.resumed": {
